events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript;

    client_max_body_size 30M;

    # IP real del cliente. Tanto cloudflared (vía Cloudflare) como Caddy (vía directa)
    # añaden la IP del cliente al final de X-Forwarded-For. Solo se confía en los
    # rangos privados de Docker; el puerto 80 ya no está expuesto a internet.
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 10.0.0.0/8;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    log_format audit '$time_iso8601 remote_addr=$remote_addr cf_country=$http_cf_ipcountry '
                      'host=$host method=$request_method uri=$request_uri status=$status '
                      'bytes=$body_bytes_sent ua="$http_user_agent"';
    access_log /var/log/nginx-audit/audit.log audit;

    upstream core_api {
        server core-api:8080;
        keepalive 32;
    }

    upstream frontend_app {
        server frontend:80;
        keepalive 16;
    }

    # Endpoint interno (solo red Docker, puerto no publicado) que Caddy consulta
    # antes de pedir un certificado bajo demanda. Responde 200 únicamente si
    # existe una app importada con ese hostname (marcador escrito por core-api).
    server {
        listen 8081;

        location = /_tls-ask {
            access_log off;
            default_type text/plain;
            if ($arg_domain !~ "^[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+$") {
                return 404;
            }
            if (!-f /etc/nginx/conf.d/apps/ask/$arg_domain) {
                return 404;
            }
            return 200 "ok\n";
        }

        location / {
            return 404;
        }
    }

    server {
        listen 80;
        server_name ${PUBLIC_DOMAIN} ${ALT_DOMAIN};

        location = /health {
            access_log off;
            return 200 "ok\n";
            add_header Content-Type text/plain;
        }

        # Los endpoints internos (core-api <-> bot-service) solo se usan dentro de
        # la red Docker; no deben ser alcanzables desde internet.
        location /api/internal/ {
            return 404;
        }

        location /api/ {
            proxy_pass http://core_api;
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_buffering off;
            proxy_read_timeout 60s;
        }

        location /ws/ {
            proxy_pass http://core_api;
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";

            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_buffering off;
        }

        location / {
            proxy_pass http://frontend_app;
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
    include /etc/nginx/conf.d/apps/*.conf;

    server {
        listen 80 default_server;
        server_name _;

        location = /health {
            access_log off;
            return 200 "ok\n";
            add_header Content-Type text/plain;
        }

        location / {
            return 404 "Not Found\n";
            add_header Content-Type text/plain;
        }
    }

}
